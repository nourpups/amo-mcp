# ============================================================
# AmoCRM credentials (always required)
# ============================================================

# AmoCRM subdomain — the part between https:// and .amocrm.ru
# Example: if your CRM is at https://mycompany.amocrm.ru, set:
AMOCRM_SUBDOMAIN=mycompany

# Long-lived JWT access token from AmoCRM integration page.
# Settings -> Integrations -> create integration -> "Keys and access" tab ->
# "Generate long-lived token". Starts with eyJ0eXAiOiJKV1Q...
AMOCRM_ACCESS_TOKEN=eyJ0eXAiOiJKV1QiLCJhbGciOiJSUzI1NiIs...

# ============================================================
# Transport (optional — defaults to stdio)
# ============================================================
# - stdio: classic mode, Claude Code spawns `node dist/index.js` locally
# - http : remote mode, Claude Code connects to http(s)://host:port/mcp
MCP_TRANSPORT=stdio

# ============================================================
# HTTP transport (required only when MCP_TRANSPORT=http)
# ============================================================

# Port the HTTP server listens on
MCP_HTTP_PORT=8765

# Bearer token clients must send as `Authorization: Bearer <token>`.
# Generate any long random string, e.g.:  openssl rand -hex 32
# WARNING: without this token, anyone reaching the URL gets read access to your AmoCRM.
MCP_HTTP_AUTH_TOKEN=

# Optional: comma-separated list of hostnames allowed in the Host header (DNS-rebinding protection).
# Leave empty to disable the check. Set when exposing publicly, e.g.:
# MCP_HTTP_ALLOWED_HOSTS=amo-mcp.example.com,127.0.0.1
MCP_HTTP_ALLOWED_HOSTS=

# ============================================================
# Docker deploy (deploy/docker-compose.yml + deploy/Caddyfile)
# ============================================================

# Public hostname Caddy will obtain a Let's Encrypt cert for
AMO_MCP_DOMAIN=amo-mcp.example.com

# Email passed to Let's Encrypt for cert expiry notifications
ACME_EMAIL=admin@example.com
