  "description": "Read-only MCP server for AmoCRM REST API v4",
  "type": "module",
  "bin": {
    "amocrm-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
